#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
/* #include "keymap_bepo.h" */

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ---------------------------------------------------------------------------------
            // | ESC |  B  |  W  |  P  |  O  |  ?  |   |  !  |  V  |  D  |  L  |  J  |BSPC |
            // | TAB |  A  |  U  |  I  |  E  |  ,  |   |  C  |  T  |  S  |  R  |  N  | DEL |
            // |LCTRL|  Z  |  Y  |  X  |  .  |  K  |   |  M  |  Q  |  R  |  H  |  F  |RSHFT|
            //                     | GUI | LWR | SPC |   | ENT | RSE | ALT |

            bindings = <
&kp ESCAPE  &kp B  &kp W  &kp P           &kp O    &kp QUESTION    &kp EXCLAMATION  &kp V  &kp D     &kp L  &kp J  &kp BSPC
&kp TAB     &kp A  &kp U  &kp I           &kp E    &kp G           &kp C            &kp T  &kp S     &kp R  &kp N  &kp DELETE
&kp LCTRL   &kp Z  &kp Y  &kp X           &kp DOT  &kp K           &kp M            &kp Q  &kp G     &kp H  &kp F  &kp RSHFT
                          &kp LEFT_SHIFT  &mo 1    &kp SPACE       &kp RET          &mo 2  &kp RALT
            >;
        };

        lower_layer {
            // --------------------------------------------------------------------------------
            // |none |  "  |  <  |  >  |  #  |  \  |   |  /  |  7  |  8  |  9  |  *  |BSPC |
            // |none |  [  |  (  |  )  |  ]  | "|" |   |  -  |  4  |  5  |  6  |  +  | DEL |
            // |none |LALT |  {  |  }  |  @  |PRTSC|   |  .  |  1  |  2  |  3  |  %  |none |
            //                   | GUI | LWR | SPC |   | ENT |  ,  |  0  |

            bindings = <
&trans  &kp DQT   &kp LESS_THAN         &kp GREATER_THAN  &kp POUND    &kp BSLH           &kp FSLH   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp STAR     &kp BSPC
&trans  &kp LBKT  &kp LEFT_PARENTHESIS  &kp RPAR          &kp RBKT     &kp PIPE           &kp MINUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PLUS     &kp DEL
&trans  &kp LALT  &kp LEFT_BRACE        &kp RIGHT_BRACE   &kp AT_SIGN  &kp PRINTSCREEN    &kp DOT    &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERCENT  &trans
                                        &trans            &trans       &trans             &trans     &kp KP_COMMA     &kp KP_NUMBER_0
            >;
        };

        raise_layer {
            // --------------------------------------------------------------------------------
            // |     |  ~  |  É  |  &  |  Œ  |  È  |   |     |PG UP|SRLUP|     |     |      |
            // |     |     |  `  |  ¨  |  €  |  $  |   |HOME | LFT | UP  | DWN | RGT | END  |
            // |     |     |     |  Æ  |  À  |  Ç  |   |     |PG DW|SCRDW|     |     |      |
            //                   | GUI |LSHFT| SPC |   |none | RSE |none |

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        Media_layer {
            // --------------------------------------------------------------------------------
            // |     |     |     |     |     |     |   |     |     |     |     |     |     |
            // |     |     |     |     |     |     |   |     |     |     |     |     |     |
            // |     |     |     |     |     |     |   |     |     |     |     |     |     |
            //                   |     |     |     |   |     |     |     |

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};

