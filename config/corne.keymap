#include "keys_fr.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>


//&led_strip {
  // chain-length = <0>;
  //chain-length = <27>;
  // 21 backlight + 6 glowlight
//};

//&zmk_underglow {
//    compatible = "zmk,underglow";
//    status = "okay";
//};

/ {
  keymap {
    compatible = "zmk,keymap";

        default_layer {
            // ---------------------------------------------------------------------------------
            // | ESC |  B  |  W  |  P  |  O  | ?/' |   | !/^ |  V  |  D  |  L  |  J  |BSPC |
            // | TAB |  A  |  U  |  I  |  E  | ,/; |   |  C  |  T  |  S  |  R  |  N  | DEL |
            // |LCTRL|  Z  |  Y  |  X  |  .  |  K  |   |  M  |  Q  |  R  |  H  |  F  |RSHFT|
            //                     | GUI | LWR | SPC |   | ENT | RSE | ALT |

            bindings = <
&kp ESCAPE  &kp FR_B  &kp FR_W  &kp FR_P        &kp FR_O             &mt FR_APOS FR_QMARK    &mt FR_CARET FR_EXCLAMATION  &kp FR_V  &kp FR_D  &kp FR_L  &kp FR_J  &kp BSPC
&kp TAB     &kp FR_A  &kp FR_U  &kp FR_I        &kp FR_E             &kp FR_G                &kp FR_C                     &kp FR_T  &kp FR_S  &kp FR_R  &kp FR_N  &kp DELETE
&sk LCTRL   &kp FR_Z  &kp FR_Y  &kp FR_X        &mt FR_DOT FR_COLON  &kp FR_K                &kp FR_M                     &kp FR_Q  &kp FR_G  &kp FR_H  &kp FR_F  &sk RSHFT
                                &sk LEFT_SHIFT  &mo 1                &kp SPACE               &kp RET                      &mo 2     &sk RALT
            >;
        };

        lower_layer {
            // --------------------------------------------------------------------------------
            // |trans| "|" |  É  |  &  |  È  |  Œ  |   |  "  |  ~  |  [  |  ]  |trans|trans|
            // |trans|  Æ  |  Ù  |  ¨  |  €  |  '  |   |  #  |  {  |  (  |  )  |  }  |trans|
            // |trans|  /  |  \  |  Ç  |  $  |PRTSC|   |  ~  |  «  |  <  |  >  |  »  |trans|
            //                   |trans| LWR |trans|   |trans|trans|trans|

            bindings = <
&trans  &kp FR_PIPE        &kp FR_E_ACUTE     &kt FR_CARET   &kp FR_E_GRAVE  &kp BSLH                &kp FR_DQT     &kp FR_TILDE       &kp FR_LEFT_BRACKET      &kp FR_RIGHT_BRACKET      &kp FR_SECTION      &kp BACKSPACE
&trans  &kp FR_UNDERSCORE  &kp FR_AMPERSAND   &kp FR_UMLAUT  &kp FR_U_GRAVE  &kp FR_CURRENCY_SIGN    &kp FR_HASH    &kp FR_LEFT_BRACE  &kp FR_LEFT_PARENTHESIS  &kp FR_RIGHT_PARENTHESIS  &kp FR_RIGHT_BRACE  &to 3
&trans  &kp FR_ASTERISK    &kp FR_POUND_SIGN  &kp FR_EURO    &kp FR_DOLLAR   &kp PRINTSCREEN         &kp FR_SQUARE  &kp FR_BACKSLASH   &kp FR_LESS_THAN         &kp FR_GREATER_THAN       &kp FR_SLASH        &kp KP_ENTER
                                              &trans         &trans          &trans                  &trans         &trans             &trans
            >;
        };

        Raise_layer {
            // --------------------------------------------------------------------------------
            // |trans|trans|trans|trans|trans|trans|   |  /  |  7  |  8  |  9  |  *  |BSPC |
            // |trans|trans|trans|trans|trans|trans|   |  -  |  4  |  5  |  6  |  +  | DEL |
            // |trans|trans|trans|trans|trans|trans|   |  .  |  1  |  2  |  3  |  %  | ENT |
            //                   |trans|trans|trans|   |trans|  ,  |  0  |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &kp FR_SLASH  &kp FR_N7  &kp FR_N8  &kp FR_N9  &kp STAR        &kp BACKSPACE
&none       &none         &bl BL_CYCLE     &bl BL_DEC       &bl BL_INC       &bl BL_TOG         &kp FR_MINUS  &kp FR_N4  &kp FR_N5  &kp FR_N6  &kp FR_PLUS     &to 3
&none       &none         &rgb_ug RGB_EFR  &rgb_ug RGB_HUD  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG    &kp FR_DOT    &kp FR_N1  &kp FR_N2  &kp FR_N3  &kp FR_PERCENT  &kp ENTER
                                           &kp LSHFT        &kp LCTRL        &kp LALT           &kp FR_COMMA  &trans     &kp FR_N0
            >;
        };

        game_layer {
            bindings = <
&kp ESC    &kp I  &kp Q  &kp W      &kp E      &kp R       &kp KP_SLASH  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_ASTERISK  &kp BACKSPACE
&kp TAB    &kp J  &kp A  &kp S      &kp D      &kp F       &kp KP_MINUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS      &trans
&kp GRAVE  &kp M  &kp Z  &kp X      &kp C      &kp V       &kp KP_DOT    &kp KP_N1        &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERCENT      &kp ENTER
                         &kp LSHFT  &kp LCTRL  &kp LALT    &to 0         &kp KP_COMMA     &kp KP_NUMBER_0
            >;
        };
    };
};

